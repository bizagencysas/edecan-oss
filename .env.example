# Edecán public configuration template
#
# Copy this file to `.env`, generate the two secrets below, and keep the
# resulting file private. Empty provider credentials disable that provider;
# the default stub providers keep local development deterministic and free.
# Full reference: docs/configuracion.md

# Runtime
ENV=dev
PUBLIC_BASE_URL=http://localhost:8000
PHONE_MAX_TURNS=8
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
LOG_LEVEL=INFO
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MOBILE_PAIRING_TTL_SECONDS=600

# Required secrets. Production refuses to start with these public values.
# JWT_SECRET: python -c "import secrets; print(secrets.token_urlsafe(32))"
# LOCAL_MASTER_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=TU_JWT_SECRET_AQUI
LOCAL_MASTER_KEY=TU_LOCAL_MASTER_KEY_FERNET_AQUI
KMS_KEY_ID=

# PostgreSQL / Redis
DATABASE_URL=postgresql+asyncpg://edecan:edecan@localhost:5432/edecan
REDIS_URL=redis://localhost:6379/0
CHAT_IDEMPOTENCY_TTL_SECONDS=86400

# S3 / SQS. These values target the LocalStack service from `make deps`.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=edecan-files
SQS_QUEUE_URL=http://localhost:4566/000000000000/edecan-jobs
#
# Cloudflare R2 instead of AWS S3: R2 speaks the S3 API, so every upload path
# (`edecan_creative._files`, `edecan_business._files`, `edecan_design_studio.storage`,
# `edecan_voice.tools`, `edecan_advisory._texto`) already works unchanged -- they all
# read AWS_ENDPOINT_URL from settings. Only these five values change:
#
#   AWS_REGION=auto                  # R2 requires literally "auto", not a region name
#   AWS_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   AWS_ACCESS_KEY_ID=<R2 Access Key ID>
#   AWS_SECRET_ACCESS_KEY=<R2 Secret Access Key>
#   S3_BUCKET=<bucket name created in the R2 dashboard>
#
# SQS_QUEUE_URL is unrelated and stays on AWS (or use QUEUE_PROVIDER=db locally).
#
# If PutObject starts failing with HTTP 400 after the switch, it is the boto3 >=1.36
# default flexible-checksum header, which not every S3-compatible backend accepts.
# Fix without touching code by exporting:
#   AWS_REQUEST_CHECKSUM_CALCULATION=when_required
#   AWS_RESPONSE_CHECKSUM_VALIDATION=when_required
#
# NOTE: this only moves where bytes are STORED. Downloads still stream through the API
# (`apps/api/edecan_api/routers/files.py` -> StreamingResponse), so clients keep hitting
# the backend. Serving straight from the edge additionally needs a public R2 custom
# domain (or presigned URLs) and a code change to hand that URL to the client.
# Hard cap per uploaded file (25 MiB by default), independent of plan quota.
MAX_UPLOAD_BYTES=26214400

# Managed inference for every non-IDE surface. These host-owned credentials
# are never exposed to tenants or accepted through chat/model-selection UI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Leave empty to use the code default (see MODELO_POR_DEFECTO in
# packages/llm/edecan_llm/workers_ai.py). Set it only to override.
# Measured 2026-07-29 on chat with tools: llama-4-scout answers a pending
# question with the right tool 3/3 and replies in ~1s; glm-4.7-flash manages
# 1/3 and peaked at 34s. Reasoning models are a poor fit here: they burn
# tokens before the first word, which reads as a stall in chat and is audible
# on a phone call.
WORKERS_AI_CHAT_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
WORKERS_AI_IDE_MODEL=@cf/zai-org/glm-5.2
WORKERS_AI_IDE_VISION_MODEL=@cf/moonshotai/kimi-k2.7-code
WORKERS_AI_TIMEOUT_SECONDS=60
# Opcional: modelo de respaldo solo para fallas antes del primer token.
# No reintenta después de emitir contenido para evitar respuestas duplicadas.
WORKERS_AI_FALLBACK_MODEL=

# Embeddings and web research
EMBEDDINGS_MODEL=
EMBEDDINGS_DIM=1536
SEARCH_PROVIDER=stub
BRAVE_API_KEY=
TAVILY_API_KEY=

# Voice. `stub` is offline and safe for first boot.
VOICE_STT_PROVIDER=stub
VOICE_TTS_PROVIDER=stub
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
POLLY_VOICE=Lupe

# OAuth application credentials. End users connect their own accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional hosted-instance services
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SES_FROM_EMAIL=
SENTRY_DSN=

# Browser, media and commerce defaults
BROWSER_FETCH_PROVIDER=httpx
BROWSER_USER_AGENT=EdecanBot/1.0
BROWSER_MAX_FETCH_BYTES=2000000
BROWSER_TIMEOUT_SECONDS=20
IMAGES_PROVIDER=stub
IMAGES_BASE_URL=
IMAGES_API_KEY=
IMAGES_MODEL=
# Content Studio usa FyDesign con configuración separada.
# Default estilo Referencia: gpt-image-2 primero, fallback imagen-4/Vertex.
EDECAN_CONTENT_IMAGE_PROVIDER=fydesign
EDECAN_CONTENT_IMAGE_MODEL=gpt-image-2
EDECAN_CONTENT_IMAGE_FALLBACK_MODEL=imagen-4
EDECAN_CONTENT_IMAGE_QUALITY=standard
EDECAN_CONTENT_IMAGE_STYLE=
EDECAN_CONTENT_IMAGE_BRAND=
# coingecko = precios de cripto reales, sin clave, sin costo (medido funcionando). "stub"
# sigue disponible pero YA NO es el default: inventaba precios con sha256 del símbolo.
QUOTES_PROVIDER=coingecko
# Only paper execution is currently supported; real-money execution is off.
COMMERCE_MODE=paper

# Agent and remote-control budgets
MISSIONS_MAX_STEPS=8
MISSIONS_STEP_TIMEOUT_SECONDS=300
MISSIONS_PARALLEL_MAX=3
# Vista interactiva: 4 frames/s como máximo; cada frame se comprime y limita.
REMOTE_FRAME_MIN_INTERVAL_SECONDS=0.25

# Desktop/local runtime. The packaged desktop app sets these automatically.
EDECAN_LOCAL_MODE=false
DATA_DIR=~/.edecan/data
SERVE_WEB_DIR=
LOCAL_API_PORT=8765
EDECAN_LOCAL_REPO_PATH=
# Core self-repair is source-only, local-only and disabled by default.
# Commands are exact JSON argv arrays; each invocation still needs approval.
EDECAN_SELF_REPAIR_ENABLED=false
EDECAN_SELF_REPAIR_TEST_COMMANDS_JSON=[]
EDECAN_SELF_REPAIR_INSTALL_COMMANDS_JSON=[]
EDECAN_SELF_REPAIR_COMMAND_TIMEOUT_SECONDS=300
QUEUE_PROVIDER=sqs
OLLAMA_BASE_URL=http://localhost:11434
CLAUDE_CLI_PATH=
CODEX_CLI_PATH=
LLM_CLI_TIMEOUT_SECONDS=300
VERTEX_MODEL_PRINCIPAL=gemini-2.5-pro
VERTEX_MODEL_RAPIDO=gemini-2.5-flash
SKILLS_INDEX_URL=https://skills.sh
HOMEASSISTANT_TIMEOUT_SECONDS=15

# Optional legacy Media Streams extension; core Twilio calls use the OSS /v1/phone routes.
TWILIO_MEDIA_STREAMS_ENABLED=false

# --------------------------------------------------------------------------- #
# Confirmation gates
# --------------------------------------------------------------------------- #
# Tools marked `dangerous` (publish, call, run a command, install a skill) stop
# the turn and wait for an explicit approval card. That default protects the
# case where whoever approves is not whoever asked -- a shared or hosted
# Edecán.
#
# Set to 1 for a PERSONAL assistant: one owner, own machine, asking for things
# himself. There the card only repeats back what he just said, and a turn
# paused for an approval the client failed to render looks exactly like a hang.
# The bundled desktop app already turns this on for that reason; this variable
# is for every other way of running Edecán.
#
# It does NOT loosen plan flags, per-tool argument validation, or OS
# permissions. It only skips the "are you sure?" card.
EDECAN_SIN_CONFIRMACIONES=

# Narrower version of the above, kept for compatibility: only `llamar_contacto`.
# Ignored when EDECAN_SIN_CONFIRMACIONES is on.
EDECAN_PHONE_REQUIRE_CONFIRMATION=
